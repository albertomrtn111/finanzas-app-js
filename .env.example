# Configuración de NextFinance. Copia este fichero a .env y rellénalo.
# En producción el .env vive solo en el servidor (/srv/finanzas-app-js/.env).

# Obligatorias: sin ellas la app no arranca (src/instrumentation.js).
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/finanzas"
NEXTAUTH_URL="http://localhost:3000"
# Al menos 32 caracteres aleatorios: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Opcional: inicio de sesión con Google (hacen falta las dos).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Opcional: espacio para documentos adjuntos por usuario, en MB (200 por defecto).
# ATTACHMENT_QUOTA_MB=200
